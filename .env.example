# h2l — Environment Configuration Template
# Copy to `.env` for Docker / server deployments. Never commit `.env`.

# Application
ASPNETCORE_ENVIRONMENT=Production
H2L_PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL (local dev container)
POSTGRES_DB=h2l
POSTGRES_USER=h2l
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# External PostgreSQL connection string (leave empty for embedded quickstart DB)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=h2l;Username=h2l;Password=CHANGE_ME_LOCAL_DB_PASSWORD
# Run EF Core migrations automatically on startup
DB_AUTO_MIGRATE=true

# JWT authentication
JWT_ISSUER=h2l
JWT_AUDIENCE=h2l-pwa
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_JWT_SIGNING_KEY_MIN_32_CHARS
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# AES-256-GCM encryption key (base64-encoded 32-byte key)
ENCRYPTION_KEY_ID=v1
ENCRYPTION_AES_GCM_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_AES_GCM_KEY

# Outbound connector network access
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
CONNECTOR_ALLOWED_HOSTS=

# File attachments
ATTACHMENTS_MAX_SIZE_MB=10
ATTACHMENTS_STORAGE_PATH=/data/attachments

# Optional SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=h2l

# Optional OpenTelemetry (OTLP)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=h2l
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
